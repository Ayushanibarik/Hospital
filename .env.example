# ==============================================================================
# DemoCare Healthcare Automation Layer - Configuration Matrix
# ==============================================================================
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 🟢 MODE 1: FREE DEMO & TESTING MODE (Default - Zero Out-of-Pocket Cost)
# ------------------------------------------------------------------------------
# In this mode, the system runs with the built-in Intelligent Simulator or
# free Google Gemini / local Ollama tokens. WhatsApp uses the free QR Bridge.
AI_PROVIDER=AUTO

# Optional Free Cloud AI (Google AI Studio - 15 req/min free):
GEMINI_API_KEY=

# Optional Local LLM (Ollama offline on PC):
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# WhatsApp Webhook Verification Token (For testing):
WHATSAPP_VERIFY_TOKEN=democare_verify_token

# ------------------------------------------------------------------------------
# 🔵 MODE 2: CLIENT PRODUCTION DEPLOYMENT (When Client Signs & Pays)
# ------------------------------------------------------------------------------
# Activate when deploying live for a hospital client:
PRODUCTION_MODE=false

# 1. Meta WhatsApp Cloud API (Hospital's Official Business Manager)
# First 1,000 service conversations/month are free by Meta; client covers overage.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# 2. Production AI Engine (Claude 3.5 Sonnet / Azure OpenAI HIPAA)
# Client covers API tokens (~$5 to $15/month for 1,000 patients)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 3. Hospital EMR / HMS API Integration
# Provided by hospital IT department (e.g. Practo, KareXpert, MocDoc)
HMS_VENDOR_NAME=
HMS_API_BASE_URL=
HMS_API_KEY=
HMS_WEBHOOK_SECRET=

# 4. Production Database (Optional: Hosted PostgreSQL or keep embedded SQLite)
# DATABASE_URL=postgresql://user:password@db.clienthospital.com:5432/hospital_automation
