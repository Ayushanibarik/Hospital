# Hospital AI Automation Layer - Environment Variables (100% Free Stack Options)
PORT=3000

# -------------------------------------------------------------
# AI PROVIDER SELECTION: 'GEMINI' | 'OLLAMA' | 'CLAUDE' | 'AUTO'
# -------------------------------------------------------------
AI_PROVIDER=AUTO

# Option 1: Google Gemini 1.5 Flash (100% FREE on Google AI Studio - No credit card required)
# Get your free key instantly: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option 2: Ollama Local LLM (100% FREE, Offline on your PC, Infinite tokens)
# Download from: https://ollama.com/
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Option 3: Anthropic Claude API (Paid per token)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# -------------------------------------------------------------
# WHATSAPP MESSAGING (Meta Cloud API has 1,000 free chats/mo)
# -------------------------------------------------------------
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
