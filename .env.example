# Hospital AI Automation Layer - Environment Variables
PORT=3000

# Anthropic Claude API (Optional for Demo mode; fallback simulator active if omitted)
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model selection (default: claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Meta WhatsApp Business Cloud API (For live production dispatch)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
